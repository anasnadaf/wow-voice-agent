# Copy to .env and fill in. Nothing here is required to boot the API skeleton;
# each milestone documents which keys it starts needing.

APP_ENV=dev
PUBLIC_BASE_URL=http://localhost:8080
# comma-separated origins allowed to call the API from a browser (the web app)
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+asyncpg://wow:wow@localhost:5432/wow

# vendor selection
STT_PROVIDER=sarvam
TTS_PROVIDER=sarvam            # sarvam | rumik | gnani
LLM_PROVIDER=groq
TELEPHONY_PROVIDER=plivo

# provider credentials
SARVAM_API_KEY=
GNANI_API_KEY=
RUMIK_API_KEY=
RUMIK_GATEWAY_URL=
GROQ_API_KEY=
CEREBRAS_API_KEY=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=

# models
CONVO_MODEL=llama-3.3-70b-versatile
EXTRACT_MODEL=llama-3.1-8b-instant
# 'low' | 'medium' | 'high' for reasoning models (gpt-oss, GLM); empty for plain ones
LLM_REASONING_EFFORT=

# Rumik voice (only read when TTS_PROVIDER=rumik)
# mulberry = described voice; muga = tone-tagged (adds tag rules to the agent prompt)
RUMIK_MODEL=mulberry
# leave RUMIK_VOICE empty to let mulberry generate the voice from the description
RUMIK_VOICE=
#RUMIK_DESCRIPTION=

MLFLOW_TRACKING_URI=http://localhost:5001
AUTH_URL=
# static admin bearer token fallback when AUTH_URL is unset (dev allows all if both empty)
ADMIN_API_TOKEN=
