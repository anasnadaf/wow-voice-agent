# Copy to .env beside compose.prod.yml on the host and fill in.
# Required values use ${VAR:?} in the compose file — the stack refuses to
# start rather than quietly defaulting a secret.

PUBLIC_BASE_URL=https://wow.anasnadaf.com

# images — pin a SHA tag here to roll back
#SERVER_IMAGE=ghcr.io/anasnadaf/wow-voice-agent-server:<sha>
#WEB_IMAGE=ghcr.io/anasnadaf/wow-voice-agent-web:<sha>

POSTGRES_USER=wow
POSTGRES_PASSWORD=
POSTGRES_DB=wow

STT_PROVIDER=sarvam
TTS_PROVIDER=sarvam
LLM_PROVIDER=groq
TELEPHONY_PROVIDER=plivo

SARVAM_API_KEY=
GNANI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=

AUTH_URL=
ADMIN_API_TOKEN=

#MLFLOW_ALLOWED_HOSTS=wowlogs.anasnadaf.com,mlflow,mlflow:5000,localhost,127.0.0.1
